# For `cargo run` from the repository root. API is local-only by default.
CONSOLE_BIND=127.0.0.1:8080
CONSOLE_ROBOTS_FILE=config/robots.json
CONSOLE_MODULES_FILE=config/modules.json
# Only needed if a separately authenticated reverse proxy serves cross-origin pages.
CONSOLE_ALLOWED_ORIGINS=

# v0.5 IMU bridge: leave disabled until a private secret is configured.
# Generate via scripts/setup-imu-ingest-token.sh; never commit real secrets.
CONSOLE_IMU_INGEST_TOKEN=
CONSOLE_IMU_ALLOWED_ROBOT_IDS=paky-01
