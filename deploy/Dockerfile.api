FROM rust:1.90-bookworm AS build
WORKDIR /work
COPY services/api/Cargo.toml services/api/Cargo.toml
COPY services/api/src services/api/src
RUN cargo build --manifest-path services/api/Cargo.toml --release

FROM debian:bookworm-slim
WORKDIR /app
RUN mkdir -p /app/data && chown 10001:10001 /app/data
COPY --from=build /work/services/api/target/release/openrgd-console-api /usr/local/bin/openrgd-console-api
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/openrgd-console-api"]
