{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openrgd:console:modules:install-request:v0.4a",
  "title": "Explicitly approved software module install request (non-actuating)",
  "type": "object",
  "additionalProperties": false,
  "required": ["module_id", "version", "mode", "confirmation"],
  "properties": {
    "module_id": {"type":"string", "pattern":"^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$", "maxLength":128},
    "version": {"type":"string", "pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength":32},
    "mode": {"enum":["source_only","build"]},
    "confirmation": {"type":"string", "maxLength":210}
  },
  "$comment": "Server additionally requires confirmation == INSTALL <module_id>@<version> <mode> and approval guard."
}
